<?xml version="1.0" encoding="UTF-8"?>
<net version="1.16" junctionCornerDetail="5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">
    <location netOffset="500.00,300.00" convBoundary="0.00,0.00,1000.00,600.00" origBoundary="-500.00,-300.00,500.00,300.00" projParameter="!"/>

    <!-- Edge Definitions -->
    <edge id="edge_west_in" from="node_west" to="node_center" priority="7">
        <lane id="edge_west_in_0" index="0" speed="20.00" length="500.00" shape="0.00,296.80 500.00,296.80"/>
